@model UHSB_Bagalkot.Service.ViewModels.LoginVM
@{
    Layout = "_LayoutMinimal";
    ViewData["Title"] = "Admin Login";


}

<head>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>

        <style>
.toast-error {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    color: #fff;
    border-radius: 14px;
}

.toast-icon {
    background: rgba(255,255,255,0.2);
    padding: 10px 12px;
    border-radius: 50%;
    font-size: 18px;
}

.toast-success {
    background: linear-gradient(135deg, #16a34a, #15803d);
}

.toast-warning {
    background: linear-gradient(135deg, #f59e0b, #d97706);
}

        #errorToast{
            background-color:red;
        }


        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8fafc;
        }

        .split-container {
            min-height: 100vh;
            display: flex;
            align-items: stretch;
        }

        .left-banner {
            background: linear-gradient(135deg,#1e3a8a 0%,#166534 100%);
            color: white;
            padding: 50px 40px;
            overflow-y: auto;
            position: relative;
        }

            .left-banner::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.3);
                z-index: 1;
            }

        .banner-content {
            position: relative;
            z-index: 2;
            max-width: 700px;
            margin: 0 auto;
        }

            .banner-content h2 {
                font-size: 2.4rem;
                font-weight: 600;
                margin-bottom: 20px;
                text-align: center;
            }

        .university-logo {
            display: block;
            margin: 0 auto 30px;
            max-width: 200px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .intro-text {
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
            gap: 15px;
            margin: 30px 0;
        }

            .gallery img {
                width: 100%;
                height: auto;
                border-radius: 12px;
                box-shadow: 0 6px 15px rgba(0,0,0,0.3);
                transition: transform 0.3s ease;
            }

                .gallery img:hover {
                    transform: scale(1.05);
                }

        .secure-note {
            font-size: 1rem;
            font-style: italic;
            text-align: center;
            margin-top: 20px;
            opacity: 0.9;
        }

        .right-login {
            background: #fff;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 60px 30px 30px;
        }

        .login-card {
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            width: 100%;
            max-width: 480px;
            overflow: hidden;
            transition: transform 0.4s ease;
        }

            .login-card:hover {
                transform: translateY(-10px);
            }

        .card-header {
            background: linear-gradient(to right,#166534,#1e3a8a);
            padding: 30px;
            text-align: center;
            color: white;
        }

            .card-header img {
                width: 90px;
                height: 90px;
                object-fit: cover;
                border: 4px solid rgba(255,255,255,0.3);
                margin-bottom: 15px;
            }

            .card-header h3 {
                font-weight: 500;
                margin: 0;
                font-size: 1.6rem;
            }

            .card-header p {
                margin: 8px 0 0;
                opacity: 0.9;
                font-size: 0.95rem;
            }

        .card-body {
            padding: 40px;
        }

        .form-control-lg {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }

            .form-control-lg:focus {
                border-color: #166534;
                box-shadow: 0 0 0 3px rgba(22,101,52,0.15);
            }

        .btn-primary {
            background: #166534;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: #134d2b;
                transform: translateY(-2px);
            }

        .btn-success {
            background: #1e3a8a;
            border: none;
            border-radius: 12px;
        }

        .card-footer-links {
            text-align: center;
            padding: 20px 40px 30px;
            background: rgba(255,255,255,0.6);
            border-top: 1px solid #eee;
        }

            .card-footer-links a {
                color: #166534;
                font-weight: 600;
                text-decoration: none;
                margin: 0 15px;
                font-size: 0.95rem;
                transition: color 0.3s ease;
            }

                .card-footer-links a:hover {
                    color: #1e3a8a;
                    text-decoration: underline;
                }

        @@media(max-width:767px) {
            .split-container {
                flex-direction: column;
            }

            .left-banner {
                padding: 40px 20px;
                min-height: auto;
            }

            .right-login {
                padding: 40px 20px;
                align-items: center;
            }

            .banner-content h2 {
                font-size: 2rem;
            }

            .gallery {
                grid-template-columns: 1fr 1fr;
            }

            .card-footer-links a {
                display: block;
                margin: 10px 0;
            }
        }
    </style>
</head>

<div class="split-container">
    <!-- LEFT SIDE -->
    <div class="left-banner col-12 col-md-7 d-none d-md-block">
        <div class="banner-content">
            <img src="https://iras-proxy-assets.s3.ap-south-1.amazonaws.com/60487f498ce6c03a76fca41e/logo/3-10-2021--9-47-01-am-logo.jpg" alt="UHS Bagalkot Logo" class="university-logo" />
            <h2>Welcome to UHSB HortiGuide Portal</h2>
            <p class="intro-text"><b>University of Horticultural Sciences, Bagalkot</b> — Established in 2008, serving 23 districts with nine colleges, diploma programs, research stations, and extension units. Promoting innovation, sustainability, and farmer empowerment via UHSB initiatives.</p>
            <div class="gallery">
                <img src="~/images/uhsb-bg.jpg" alt="UHSB Campus" />
                <img src="~/images/banner2.jpg" alt="UHSB Campus View" />
                <img src="~/images/banners/applogo.jpg" alt="App Logo" />
                <img src="~/images/appimages/register.jpeg" alt="Register Screen" />
                <img src="~/images/appimages/login.jpeg" alt="Login Screen" />
                <img src="~/images/appimages/homepage.jpeg" alt="Homepage" />
                <img src="~/images/appimages/category.jpeg" alt="Category View" />
            </div>
            <p class="secure-note"><i class="bi bi-shield-lock me-2"></i>All administrators are required to use multi-factor authentication (OTP).</p>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="right-login col-12 col-md-5">
        <div class="login-card">
            <div class="card-header">
                <img src="~/images/icon.jpg" alt="UHSB Logo" class="rounded-circle" />
                <h3>UHSB HortiGuide Login</h3>
                <p>University of Horticultural Sciences, Bagalkot</p>
            </div>
            <div class="card-body">
                <h4 class="text-center mb-4 text-secondary fw-semibold">Secure Login</h4>

                <!-- Role Selection -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Role</label>
                    <select id="ddlRole" class="form-select">
                        <option value="0">Select Role / ಪಾತ್ರ ಆಯ್ಕೆಮಾಡಿ</option>
                        <option value="1">Admin / ಆಡಳಿತಾಧಿಕಾರಿ</option>
                        <option value="2">Farmer / ರೈತ</option>
                        <option value="3">Scientist / ವಿಜ್ಞಾನಿ</option>
                        <option value="4">Input Dealer / ಇನ್‌ಪುಟ್ ವ್ಯಾಪಾರಿ</option>
                        <option value="5">Student / ವಿದ್ಯಾರ್ಥಿ</option>
                        <option value="6">Others / ಇತರರು</option>
                    </select>

                </div>

                <form id="loginForm">
                    <div class="mb-3" id="divUserName">
                        <label asp-for="UserName" class="form-label fw-semibold">Username </label>
                        <input asp-for="UserName" id="UserName" class="form-control form-control-lg" placeholder="Enter username or email" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3" id="divPhoneNumber">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control form-control-lg" placeholder="Enter registered phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe" />
                            <label class="form-check-label small" for="rememberMe">Remember Me</label>
                        </div>
                        <div id="otpInfo" class="text-success small fw-semibold" style="display:none;"></div>
                    </div>

                    <div class="mb-4" id="otpContainer" style="display:none;">
                        <label for="Otp" class="form-label fw-semibold">One-Time Password (OTP)</label>
                        <input type="text" id="Otp" class="form-control form-control-lg" placeholder="Enter 6-digit OTP" maxlength="6" />
                        <span id="otpError" class="text-danger small"></span>
                        <div class="mt-2 text-center small">
                            <span id="countdown" class="text-muted" style="display:none;"></span>
                            <a href="#" id="resendOtp" class="text-primary text-decoration-none" style="display:none;">Resend OTP</a>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" id="sendOtpBtn" class="btn btn-primary btn-lg shadow-sm">Send OTP & Login</button>
                        <button type="button" id="verifyOtpBtn" class="btn btn-success btn-lg shadow-sm mt-2" style="display:none;">Verify OTP & Login</button>
                        <button type="button" id="sendwithoutOtpBtn" class="btn btn-primary btn-lg shadow-sm">Login</button>
                    </div>
                </form>
            </div>

            <div class="card-footer-links">
                <a asp-controller="Account" asp-action="Register">New Account? Register Here</a>
                <a asp-controller="Dashboard" asp-action="AdminHome">Back To Home</a>
                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-outline-primary btn-sm me-2">
                    New Account
                </a>

                <a asp-controller="Dashboard"
                   asp-action="AdminHome"
                   class="btn btn-outline-secondary btn-sm">
                    Back to Home
                </a>

            </div>
        </div>
    </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="errorToast" class="toast toast-error shadow-lg border-0" role="alert">
        <div class="d-flex align-items-center">
            <div class="toast-icon me-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="toast-body fw-semibold" id="toastBody"></div>
            <button type="button" class="btn-close btn-close-white ms-2 me-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/rootpathfinder.js"></script>
    <script>
                var rootPathList = ["/", "/UHSBWeb"];
        function GetRootPath(virtualPath) {
            if (window.currentTradeId == 7) {
                //LVB
                var pathIndex = $.inArray(virtualPath, rootPathList);
                if (pathIndex != -1) {
                    return (pathIndex == 0) ? rootPathList[pathIndex] : rootPathList[pathIndex] + "/";
                }
            }
            else {
                return $('#rootpath').text();
            }
        }

                $(document).ready(function(){
                    var RoleypeId = 0;
                             var isOtpEnabled = @((ViewBag.OtpEnable ?? false).ToString().ToLower());
                    // Restore localstorage
                    if(localStorage.getItem("UserName")) {
                        $('#UserName').val(localStorage.getItem("UserName"));
                        $('#PhoneNumber').val(localStorage.getItem("PhoneNumber"));
                        $('#rememberMe').prop('checked',true);
                    }

                    // Toggle OTP vs Phone-only login based on role
                           function toggleLoginFields() {
                    var role = $('#ddlRole').val();
                      roleTypeId = parseInt(role, 10);
                           debugger ;
                    if (role === "1" || role === "3") {   // Admin & Scientist → OTP
                                if(isOtpEnabled==true || isOtpEnabled == "true"){
                                             $('#divUserName').show();
                                    $('#divPhoneNumber').show();
                                    $('#sendOtpBtn').show();
                                    $('#verifyOtpBtn').hide();
                                    $('#sendwithoutOtpBtn').hide();
                                    $('#otpContainer,#otpInfo').hide();
                                }
                                else
                                {
                                  

                                       $('#divUserName').hide();
                        $('#divPhoneNumber').show();
                        $('#sendOtpBtn,#verifyOtpBtn').hide();
                        $('#sendwithoutOtpBtn').show();
                        $('#otpContainer,#otpInfo').hide();
                                }
                    } else if (role != "0" || role != 0) {           // Other roles → No OTP
                        $('#divUserName').hide();
                        $('#divPhoneNumber').show();
                        $('#sendOtpBtn,#verifyOtpBtn').hide();
                        $('#sendwithoutOtpBtn').show();
                        $('#otpContainer,#otpInfo').hide();

                    } else {                              // No role selected
                        $('#divUserName,#divPhoneNumber').hide();
                        $('#sendOtpBtn,#verifyOtpBtn,#sendwithoutOtpBtn').hide();
                        $('#otpContainer,#otpInfo').hide();
                    }
                }

                    $('#ddlRole').change(toggleLoginFields);
                    $('#ddlRole').trigger('change');

                    // Timer function for OTP
                    let timerInterval;
                    const startTimer = () => {
                        let time=180;
                        $('#resendOtp').off('click').hide();
                        $('#countdown').show();
                        if(timerInterval) clearInterval(timerInterval);
                        timerInterval=setInterval(()=>{
                            $('#countdown').text("Resend in "+time+" sec");
                            time--;
                            if(time<0){
                                clearInterval(timerInterval);
                                $('#countdown').hide();
                                $('#resendOtp').show().off('click').on('click',function(e){
                                    e.preventDefault(); sendOtpRequest( GetRootPath(window.virtualPath)  +'/Account/SendOtp',true);
                                });
                            }
                        },1000);
                    };

                    // Mask email
                    const maskEmail = email=>{
                        if(!email) return "";
                        let [name,domain]=email.split("@@");
                        const maskedName=name.length>3?name.charAt(0)+'***'+name.charAt(name.length-1):'***';
                        return maskedName+"@@"+domain;
                    };

                    // AJAX send OTP or phone login
                    const sendOtpRequest=(url,isOtp)=>{
                        let obj={
                            UserName:$('#UserName').val(),
                            PhoneNumber:$('#PhoneNumber').val(),
                            IsFromadmin:true,
                            RoleypeId:roleTypeId
                        };
                        if(isOtp){
                            $("#sendOtpBtn").prop("disabled",true).html(`<span class='spinner-border spinner-border-sm'></span> Sending...`);
                            $('#otpError').text("");
                            $('#otpInfo').hide();
                        } else {
                            $("#sendwithoutOtpBtn").prop("disabled",true).html(`<span class='spinner-border spinner-border-sm'></span> Processing...`);
                        }

                        $.ajax({
                            url:url,
                            method:'POST',
                            contentType:'application/json',
                            data:JSON.stringify(obj),
                            success:function(res){
                                if(isOtp){
                                    $("#sendOtpBtn").prop("disabled",false).text("Send OTP & Login");
                                    if(!res.success)
                                    {
                                        $('#otpError').text(res.message||"Login failed.");
                                        $('#toastBody').text(res.message);

                                            var toastEl = document.getElementById('errorToast');
                                            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                                            toast.show();
                                        return;
                                    }

                                    if(res.redirectUrl){ window.location.href=res.redirectUrl; return; }

                                    $("#otpContainer").slideDown();
                                    $("#otpInfo").html(`<i class="bi bi-check-circle me-1"></i> OTP sent to: ${maskEmail(res.email)}`).show();
                                    $("#verifyOtpBtn").show();
                                    $("#sendOtpBtn").hide();
                                    $("#verifyOtpBtn").data("userId",res.userId);
                                    startTimer();
                                } else {
                                    if (res.success) {
                                            window.location.href = res.redirectUrl;
                                        } else {
                                            $('#toastBody').text(res.message);

                                            var toastEl = document.getElementById('errorToast');
                                            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                                            toast.show();

                                            $("#sendwithoutOtpBtn").prop("disabled", false).text("Login");
                                        }
                                }
                            },
                            error:()=>{ if(isOtp){ $("#sendOtpBtn").prop("disabled",false).text("Send OTP & Login"); } else { $("#sendwithoutOtpBtn").prop("disabled",false).text("Login"); } }
                        });
                    };

                    // Click handlers
                    $('#sendOtpBtn,#sendwithoutOtpBtn,#resendOtp').click(function(e){
                        e.preventDefault();
                        if($('#rememberMe').is(':checked')){
                            localStorage.setItem("UserName",$('#UserName').val());
                            localStorage.setItem("PhoneNumber",$('#PhoneNumber').val());
                        }
                        else
                        {
                            localStorage.clear();
                        }

                        let url=""; let isOtp=false;
                        if(this.id==="sendOtpBtn"||this.id==="resendOtp")
                        {
                            url= GetRootPath(window.virtualPath)+'/Account/SendOtp'; isOtp=true;
                        }
                        else if(this.id==="sendwithoutOtpBtn")
                        {
                            url= GetRootPath(window.virtualPath)+'/Account/Login';
                        }
                        if(url) sendOtpRequest(url,isOtp);
                    });

                    $('#Otp').on("input",()=>$('#otpError').text(""));

                    $('#verifyOtpBtn').click(function(){
                        let otp=$('#Otp').val();
                        let userId=$(this).data('userId');
                        if(!otp) return $('#otpError').text("Please enter the received OTP.");
                        if(!userId){ console.error("User session lost. Please try again."); return; }
                        $("#verifyOtpBtn").prop("disabled",true).html(`<span class='spinner-border spinner-border-sm'></span> Verifying...`);
                        let obj={ UserId:userId, Otp:otp, UserName:$('#UserName').val(), PhoneNumber:$('#PhoneNumber').val(), IsFromadmin:true };
                        $.ajax({
                            url: GetRootPath(window.virtualPath)+"/Account/VerifyOtpPost",
                            type:"POST",
                            contentType:"application/json",
                            data:JSON.stringify(obj),
                            success:(res)=>{ $("#verifyOtpBtn").prop("disabled",false).text("Verify OTP & Login"); if(res.success){ window.location.href=res.redirectUrl; } else { $('#otpError').text(res.message||"OTP verification failed."); } },
                            error:()=>{ $("#verifyOtpBtn").prop("disabled",false).text("Verify OTP & Login"); }
                        });
                    });

                });
    </script>
}
