@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using UHSB_Bagalkot.Service.Common
@model UHSB_Bagalkot.Service.ViewModels.UserMasterVM

@{
    ViewData["Title"] = "User Master";
 //   var role = Convert.ToInt32(Context.Session.GetString("userRoleType"));
    var role = ViewBag.Role;

}


<div class="container mt-3 mt-md-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="custom_card card-header text-white py-3 rounded-top-4">
            <strong>User Registration </strong>
        </div>

        <div class="card-body p-3 p-md-4">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "form1", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="text-danger mb-3" id="error_container"></div>

                <div class="row g-3">

                    <!-- User Name -->
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.UserName, new { @class = "form-label fw-semibold" })
                        <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", id = "UserName", placeholder = "Enter full name" })
                        <span class="text-danger small" id="errorUserName"></span>
                    </div>

                    <!-- Role -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Select Role <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(
                        m => m.RoleType,
                                        new SelectList(Model.RoleTypeList, "Key", "Value", Model.RoleType),
                                        "-- Select Role --",
                                        new { @class = "form-select", id = "RoleType" }
                                        )
                    <span class="text-danger small" id="errorRoleType"></span>
                </div>

                <!-- District -->
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold">Select District <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(
                                        m => m.DistrictsId,
                                        new SelectList(Model.DistrictsList, "Key", "Value", Model.DistrictsId),
                                        "-- Select District --",
                                        new { @class = "form-select", id = "DistrictsId" }
                                        )
                    <span class="text-danger small" id="errorDistrictsId"></span>
                </div>

                <!-- Village -->
                <div class="col-12 col-md-6">
                    @Html.LabelFor(m => m.Village, new { @class = "form-label fw-semibold" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.Village, new { @class = "form-control", id = "Village", placeholder = "Enter village" })
                    <span class="text-danger small" id="errorVillage"></span>
                </div>

                <!-- Phone -->
                <div class="col-12 col-md-6">
                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", id = "PhoneNumber", placeholder = "10 digit mobile number" })
                    <span class="text-danger small" id="errorPhoneNumber"></span>
                </div>

                <!-- Farmer -->
                @* <div class="col-12 col-md-6 role-farmer d-none">
                    @Html.LabelFor(m => m.LandSize, new { @class = "form-label fw-semibold" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.LandSize, new { @class = "form-control", id = "LandSize", type = "number", placeholder = "Land size in acres" })
                    <span class="text-danger small" id="errorLandSize"></span>
                </div> *@

                <!-- Scientist -->
                <div class="col-12 col-md-6 role-scientist d-none">
                    @Html.LabelFor(m => m.EmployeeId, new { @class = "form-label fw-semibold" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.EmployeeId, new { @class = "form-control mb-2", id = "EmployeeId", placeholder = "Employee ID" })
                    <span class="text-danger small" id="errorEmployeeId"></span>

                    @Html.LabelFor(m => m.EmailId, new { @class = "form-label fw-semibold mt-2" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control", id = "EmailId", type = "email", placeholder = "Email address" })
                    <span class="text-danger small" id="errorEmailId"></span>
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex flex-column flex-md-row justify-content-md-end gap-2 mt-4">
                <button type="button" class="btn btn-primary px-4" id="btnRegister">
                    Save
                </button>

            </div>
                        }
        </div>
    </div>
</div>





@if (role == (int)CommonEnum.UserRoleType.Admin)
{
    <section id="gridContent" class="container mt-5">
        <div class="card shadow-sm border-0">
            <div class="custom_card card-header text-white">
                <strong>User List</strong>
                <button class="btn btn-primary btn-sm" type="button" id="griddata">
                    <i class="bi bi-arrow-repeat me-1"></i> Refresh
                </button>
            </div>
            <div class="card-body">
                <div class="mb-3" id="multiGridFilter"></div>

                @await Html.PartialAsync("_GridPagingHeader")

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:100px;">Action</th>
                                <th style="width:60px;">Sl No.</th>
                                <th>@Html.DisplayNameFor(m => m.UserName)</th>
                                <th>@Html.DisplayNameFor(m => m.RoleType)</th>
                                <th>@Html.DisplayNameFor(m => m.DistrictsName)</th>
                                <th>@Html.DisplayNameFor(m => m.Village)</th>
                                <th>@Html.DisplayNameFor(m => m.PhoneNumber)</th>
                                <th>@Html.DisplayNameFor(m => m.IsActive)</th>
                                <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>
                            </tr>
                        </thead>
                        <tbody id="gridBody">
                        </tbody>
                    </table>

                    <div id="ajaxLoader" class="text-center mt-3 d-none">
                        <img src="~/images/webapploader.gif" alt="Loading..." />
                    </div>
                </div>
            </div>
        </div>
    </section>
}
@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/js/register_index.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/paging.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic_gridfilter.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/rootpathfinder.js"></script>
}
