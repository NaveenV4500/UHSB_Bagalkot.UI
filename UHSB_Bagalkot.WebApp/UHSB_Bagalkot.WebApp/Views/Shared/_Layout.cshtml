<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hortiguide App | UHS Bagalkot</title>

    <meta name="description"
          content="Hortiguide App by University of Horticultural Sciences Bagalkot. Crop advisory, farmer guidance and horticulture support." />

    <meta name="keywords"
          content="Hortiguide app, Hortiguide uhs bagalkot, uhsb guide bagalkot, horticulture bagalkot, farmer guide uhs bagalkot" />

    <meta name="robots" content="index, follow" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UHSB_Bagalkot.WebApp.styles.css" asp-append-version="true" />

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Kannada&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1e40af;
            --bg-light: #f8fafc;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-light);
            font-family: 'Noto Sans Kannada', sans-serif;
        }

        main {
            flex: 1;
        }

        /* Navbar */
        .navbar {
            border-radius: 0 0 1rem 1rem;
        }

        .navbar-brand img {
            height: 42px;
        }

        .nav-link {
            font-weight: 500;
        }

        .nav-link:hover {
            color: var(--primary) !important;
        }

        .dropdown-menu {
            border-radius: 0.75rem;
            border: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .dropdown-item:hover {
            background-color: var(--primary);
            color: #fff;
        }

        /* Buttons */
        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
            border-radius: 0.5rem;
        }

        .btn-primary:hover {
            background-color: var(--primary-dark);
        }

        /* Footer */
        footer {
            background: #ffffff;
            border-radius: 1rem 1rem 0 0;
        }

        /* Utility */
        .shadow-soft {
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }
    </style>
</head>

<body class="container px-0">

    <span id="rootpath" hidden>@Url.Content("~")</span>

    <!-- 🔹 NAVBAR -->
    <header class="mb-4">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-soft px-3">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Dashboard" asp-action="AdminHome">
                    <img src="~/images/Banners/namebannerlogo.png" alt="UHSB Logo" />
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="AdminHome">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear-fill me-1"></i> Master
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Register">
                                            User Master
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-book me-1"></i> Horticulture Handbook
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Horticulturehandbookweb"
                                           asp-action="Index">
                                            Manage Handbooks
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Dashboard"
                                           asp-action="CropManage">
                                            Manage Crops
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                    Weather Report
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="WeatherReportFiles"
                                           asp-action="Index">
                                            Upload Weather Report
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Right Side -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle text-primary"></i>
                                    <strong>@User.Identity.Name</strong>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary btn-sm"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- 🔹 MAIN CONTENT -->
    <main class="container-fluid px-3 px-md-4">
        @RenderBody()
    </main>

    <!-- 🔹 FOOTER -->
    <footer class="mt-4 py-3 shadow-soft">
        <div class="container-fluid d-flex justify-content-between small text-muted">
            <span>© 2025 University of Horticultural Sciences, Bagalkot</span>
            <span>Developed by <strong>Naveen V</strong></span>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
