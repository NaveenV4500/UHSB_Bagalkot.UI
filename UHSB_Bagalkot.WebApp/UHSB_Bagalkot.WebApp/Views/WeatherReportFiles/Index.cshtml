@model UHSB_Bagalkot.Service.ViewModels.WeatherFileUploadVM
@{
    ViewData["Title"] = "Upload Weather Report";
}

<style>
    .form-label {
        text-align: left;
    }
</style>

<div class="container mt-5">
    <div class="card shadow rounded-3">
        <div class="card-header  " style="background-color:#bebeff">
            <h5 class="mb-0">Upload Weather Report</h5>
        </div>

        <div class="card-body">
            <form id="uploadForm" asp-action="UploadFile" asp-controller="WeatherReportFiles" method="post" enctype="multipart/form-data">
                <div class="row g-3 align-items-center">

                    <!-- Row 1 -->
                    <div class="col-md-2 text-end">
                        <label for="DistrictId" class="form-label fw-semibold">District<span class="text-danger"> *</span></label>
                    </div>
                    <div class="col-md-4">
                        <select asp-for="DistrictId" id="DistrictId" class="form-select" asp-items="@(new SelectList(ViewBag.Districts, "Id", "Text"))">
                            <option value="">-- Select District --</option>
                        </select>
                    </div>

                    <div class="col-md-2 text-end">
                        <label for="Description" class="form-label fw-semibold">Description</label>
                    </div>
                    <div class="col-md-4">
                        <textarea asp-for="Description" id="Description" class="form-control" rows="1" placeholder="Enter description"></textarea>
                    </div>

                    <!-- Row 2 -->
                    <div class="col-md-2 text-end">
                        <label for="StartDate" class="form-label fw-semibold">Start Date</label>
                    </div>
                    <div class="col-md-4">
                        <input type="date" id="StartDate" name="StartDate" class="form-control" required />
                    </div>

                    <div class="col-md-2 text-end">
                        <label for="EndDate" class="form-label fw-semibold">End Date</label>
                    </div>
                    <div class="col-md-4">
                        <input type="date" id="EndDate" name="EndDate" class="form-control" required />
                    </div>

                    <!-- Row 3 -->
                    <div class="col-md-2 text-end">
                        <label for="file" class="form-label fw-semibold">Upload File</label>
                    </div>
                    <div class="col-md-4">
                        <input type="file" id="file" name="file" class="form-control" required />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="button" class="btn btn-secondary me-2">Cancel</button>
                    <button type="submit" class="btn btn-success">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
 
@section Scripts {
    <script src="~/js/rootpathfinder.js"></script>
    <script src="~/js/WeatherReportFiles_Index.js"></script>

    <script>
       
            var message = '@TempData["Message"]';
            if (message && message.trim() !== "") {
                alert(message);
            }
       
    </script>
}

