<style>
    .btn,.btn-outline-primary{
        width:180px;
    }
    .district-btn-container {
    max-width: 1000px;
}

.district-btn {
    height: 60px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    font-family: "Noto Sans Kannada", "Segoe UI", sans-serif;
    transition: all 0.25s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
}

.district-btn:hover {
    background-color: #0d6efd;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(13,110,253,0.35);
}

</style>

<div class="container mt-4">
    <div id="DistrictButtons" class="row justify-content-center district-btn-container"></div>
</div>

@Html.Hidden("fileBaseUrl", ViewBag.fileBaseUrl, new { id = "fileBaseUrl" })
 
<div class="modal fade"
     id="weeklyWeatherModal"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Weekly Weather Report</h5>

                <!-- ONLY close button -->
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body" id="weeklyWeatherBody">
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/paging.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic_gridfilter.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic_pagination.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/rootpathfinder.js"></script>
    <script src="~/js/weatherfilesdetails.js"></script>
}