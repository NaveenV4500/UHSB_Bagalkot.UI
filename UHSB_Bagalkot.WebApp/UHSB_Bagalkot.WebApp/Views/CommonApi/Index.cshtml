<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Horticulture Handbook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body class="bg-light">

    <div class="container py-4">
        <h3 class="text-center mb-4">ಹೊರ್ಟಿಕಲ್ಚರ್ ಹ್ಯಾಂಡ್‌ಬುಕ್ ವರ್ಗಗಳು</h3>
        <div class="row" id="categoryList"></div>
    </div>

    <script>
        $(document).ready(function () {

            function callGetApi(actionName, params = {}, onSuccess, onError) {
                $.ajax({
                    url: '/CommonApi/forwardapiresponse',
                    type: 'GET',
                    data: Object.assign({ action_name: actionName }, params),
                    success: function (response) {
                        if (onSuccess) onSuccess(response);
                    },
                    error: function (xhr) {
                        console.error('GET API Error:', xhr);
                        if (onError) onError(xhr);
                    }
                });
            }

            // Fetch categories on load
            getCategories();

            function getCategories() {
                callGetApi('getgridContentcategories', {}, function (data) {
                    renderCategories(data);
                });
            }

            function renderCategories(categories) {
                let html = '';

                $.each(categories, function (index, category) {
                    // Handle null or "null" image paths
                    let imageSrc = (category.imageUrl && category.imageUrl !== "null")
                        ? category.imageUrl
                        : 'https://via.placeholder.com/150?text=No+Image';

                    html += `
                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <img src="${imageSrc}" class="card-img-top" alt="${category.name}" style="height:200px; object-fit:cover;">
                                <div class="card-body text-center">
                                    <h5 class="card-title fw-bold">${category.name}</h5>
                                </div>
                            </div>
                        </div>
                    `;
                });

                $('#categoryList').html(html);
            }

        });
    </script>

</body>
</html>
