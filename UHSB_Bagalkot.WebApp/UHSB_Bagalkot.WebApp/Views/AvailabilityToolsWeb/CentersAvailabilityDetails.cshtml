@model UHSB_Bagalkot.Service.ViewModels.Product.ProductsVM
@using Microsoft.AspNetCore.Mvc.Rendering
@using UHSB_Bagalkot.Service.Common
@using static UHSB_Bagalkot.Service.Common.CommonEnum

<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Kannada&display=swap" rel="stylesheet">

<style>
    #formPopup #custom_panel .panel-heading {
        margin: 5px 5px 0 5px;
        padding: 5px 15px;
    }

    #formPopup .form_section {
        margin: 0 0 15px 0;
    }

    #formPopup #custom_panel .panel-body {
        padding-bottom: 10px;
    }

    #table_dropdownlist th {
        text-align: left;
        padding: 5px;
        overflow-wrap: break-word;
        background-color: #c1dbfa;
    }

    #table_dropdownlist td {
        text-align: left;
        padding: 5px;
        overflow-wrap: break-word;
        cursor: pointer;
    }

    #table_dropdownlist tr:nth-child(even) {
        background: #f3f3f3;
    }

    #input_search {
        background-color: #fff !important;
    }

    .highlight {
        background-color: #6da9bd !important;
        color: #fff;
    }

    .hideChanges {
        display: none;
    }

    .colorChanges {
        color: red;
    }

    /* Kannada font globally */
    body, input, textarea, select, .btn {
        font-family: 'Noto Sans Kannada', Arial, sans-serif;
    }

    /* Loader style */
    #loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        z-index: 1050;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .form-control-file {
        border: 1px solid #ced4da;
        padding: .375rem .75rem;
        border-radius: .25rem;
    }

    /* Smaller controls */
    .form-select-sm, .btn-sm {
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }
</style>
 

<div class="container">

   

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

