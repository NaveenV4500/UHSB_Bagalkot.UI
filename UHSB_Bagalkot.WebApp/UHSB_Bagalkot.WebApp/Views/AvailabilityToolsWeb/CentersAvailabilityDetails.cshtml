@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/CentersAvailabilityDetails_Index.js"></script>

    <script src="~/js/paging.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic_gridfilter.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/generic.js?version=@Guid.NewGuid()"></script>
    <script src="~/js/rootpathfinder.js"></script>


    <script>

             //Ajax begin Form

        function onBegin() {
            $("#loader").show();
        }

        function onSuccess(response) {
            $("#loader").hide();

            // If View returned (HTML)
            if (typeof response === "string") {
                document.open();
                document.write(response);
                document.close();
                return;
            }

            if (response.success) {
                alert("Saved successfully");
            } else {
                alert(response.message || "Failed");
            }
        }

        function onFailure() {
            $("#loader").hide();
            alert("Something went wrong");
        }

</script>
}
