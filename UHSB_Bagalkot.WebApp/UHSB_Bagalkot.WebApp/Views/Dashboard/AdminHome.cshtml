@model UHSB_Bagalkot.Service.ViewModels.AdminDashboard.AdminDashboardVM
@{
    ViewData["Title"] = "Farmer Dashboard";
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    string loginUrl = Url.Action("Login", "Account");

    string GetGreeting()
    {
        var h = DateTime.Now.Hour;
        if (h < 12) return "ಶುಭೋದಯ";
        else if (h < 17) return "ಶುಭ ಮಧ್ಯಾಹ್ನ";
        else return "ಶುಭ ಸಂಜೆ";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="~/css/dashboard-cards.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        .banner-bg {
            min-height: 350px;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        @@media (max-width:768px) {
            .banner-bg { min-height:220px; }
        }

        .service-card-locked {
            opacity: .6;
            position: relative;
        }

        .lock-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.45);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.8rem;
            border-radius: 1rem;
        }
    </style>
</head>

<body>

<!-- ================= BANNER ================= -->
<div class="banner-bg"
     style="background-image:url('@Url.Content("~/Images/banner2.jpg")');">
</div>

<!-- ================= HEADER ================= -->
<div class="card border-0" style="border-radius:1rem;">
    <div class="card-body p-sm-5">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted">🌿 @GetGreeting()  @(isAuthenticated ? User.Identity.Name : "Guest")</div>
                @* <div class="fw-bold fs-4">
                   
                </div> *@
            </div>

            <div class="rounded-circle d-flex flex-column align-items-center justify-content-center"
                 style="width:80px;height:80px;background:#22c55e;color:white;">
                <span class="fw-bold fs-4">@ViewBag.usercount+</span>
                <small>Farmers</small>
            </div>
        </div>
    </div>
</div>

<!-- ================= SERVICES ================= -->
<div class="section-title mt-4">ತ್ವರಿತ ಸೇವೆಗಳು</div>
<div class="section-sub">Quick Services</div>

<div class="grid-container ">

<!-- ================= CARD 1 ================= -->
@if (!isAuthenticated)
{
    <a href="@loginUrl" class="service-card-link">
        <div class="service-card service-card-locked">
            <div class="service-icon" style="background:linear-gradient(135deg,#43cea2,#185a9d);">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="service-title-kn">ತೋಟಗಾರಿಕೆ ಕೈಪಿಡಿ</div>
            <div class="service-title-en">Horticulture Guide</div>
            <div class="lock-overlay"><i class="fa-solid fa-lock"></i></div>
        </div>
    </a>
}
else
{
    <a href="@Url.Action("CategoryIndex","Horticulturehandbookweb")" class="service-card-link">
