@{
    ViewData["Title"] = "ರೈತರ ಪ್ರಶ್ನೋತ್ತರ | Hortiguide";
}

<div class="container mt-5" style="max-width:850px;">

    <!-- PAGE TITLE -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">🌾 ರೈತರ ಪ್ರಶ್ನೋತ್ತರ</h2>
        <p class="text-muted fs-6">Farmer Questions & Scientist Answers</p>
    </div>

    <!-- Q&A CARD 1 -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <p class="mb-2">
                <strong>👨‍🌾 ರೈತ ಪ್ರಶ್ನೆ:</strong><br />
                ಎಲೆಗಳು ಹಳದಿಯಾಗುತ್ತಿವೆ, ಏನು ಮಾಡಬೇಕು?
            </p>
            <hr class="my-2">
            <p class="mb-0">
                <strong>👩‍🔬 ತಜ್ಞರ ಉತ್ತರ:</strong><br />
                ಇದು ನೈಟ್ರಜನ ಕೊರತೆಯ ಲಕ್ಷಣವಾಗಿರಬಹುದು. ಮಣ್ಣಿನ ಪರೀಕ್ಷೆ ಮಾಡಿ ಶಿಫಾರಸು ಮಾಡಿದಂತೆ ಯೂರಿಯಾ ಹಾಕಿ.
                <br />
                <small class="text-muted">
                    Yellowing of leaves may be due to nitrogen deficiency. Apply urea as per soil test recommendation.
                </small>
            </p>
        </div>
    </div>

    <!-- Q&A CARD 2 -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <p class="mb-2">
                <strong>👨‍🌾 ರೈತ ಪ್ರಶ್ನೆ:</strong><br />
                ಮಳೆಯ ನಂತರ ಬೆಳೆಯಲ್ಲಿ ರೋಗ ಬರುತ್ತಿದೆ, ಕಾರಣವೇನು?
            </p>
            <hr class="my-2">
            <p class="mb-0">
                <strong>👩‍🔬 ತಜ್ಞರ ಉತ್ತರ:</strong><br />
                ಹೆಚ್ಚಿನ ತೇವಾಂಶದಿಂದ ಶಿಲೀಂಧ್ರ ರೋಗ ಬರಬಹುದು. ಶಿಫಾರಸು ಮಾಡಿದ ಶಿಲೀಂಧ್ರನಾಶಕ ಬಳಸಿ.
                <br />
                <small class="text-muted">
                    High moisture after rain can cause fungal diseases. Use recommended fungicide.
                </small>
            </p>
        </div>
    </div>

    <!-- Q&A CARD 3 (example, can add more) -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <p class="mb-2">
                <strong>👨‍🌾 ರೈತ ಪ್ರಶ್ನೆ:</strong><br />
                ಈ ಬೆಳೆಗೆ ಯಾವ ರಸಗೊಬ್ಬರ ಬೇಕು?
            </p>
            <hr class="my-2">
            <p class="mb-0">
                <strong>👩‍🔬 ತಜ್ಞರ ಉತ್ತರ:</strong><br />
                ಶಿಫಾರಸು ಮಾಡಿದ ಪ್ರಮಾಣದ ಯೂರಿಯಾ ಅಥವಾ ಡಿಎಪಿ ಬಳಸಿ. ಮಣ್ಣು ಪರೀಕ್ಷೆ ಮಾಡಿ ಅನುಸರಿಸಿ.
                <br />
                <small class="text-muted">
                    Use recommended amount of urea or DAP. Follow soil test recommendations.
                </small>
            </p>
        </div>
    </div>

</div>
