@using Microsoft.AspNetCore.Html
@* The Controller passes the following variables via ViewBag *@
@{
    var itemId = ViewBag.ItemId?.ToString();
    var cropName = ViewBag.CropName?.ToString();
    var sectionName = ViewBag.SectionName?.ToString();
    var categoryName = ViewBag.CategoryName?.ToString();
    var cropId = ViewBag.CropId?.ToString();
    var itemName = ViewBag.itemName?.ToString();
    
    ViewData["Title"] = $"{sectionName ?? "Content"} Details";

    var homeRoute = "/";
    var categoryRoute = "/HorticultureGuide/Category";
    var sectionListRoute = $"/HorticultureGuide/SectionIndex?cropId={cropId}&cropName={Uri.EscapeDataString(cropName ?? "")}&categoryName={Uri.EscapeDataString(categoryName ?? "")}";
}
  
<link rel="stylesheet" href="~/css/cardstyle.css" />

<style>
    .top-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        padding: 10px 15px;
        background: #fff;
        border-bottom: 1px solid #ddd;
        font-size: 0.95rem;
    }

        .top-nav a {
            text-decoration: none;
            color: #555;
        }

        .top-nav i {
            color: #ccc;
            font-size: 10px;
            margin: 0 5px;
        }

        .top-nav .breadcrumb-item {
            margin: 0 5px;
            white-space: nowrap;
        }

        .top-nav .breadcrumb-active {
            font-weight: bold;
            color: #333;
        }

        .top-nav .back-arrow {
            font-size: 1.2rem;
            margin-right: 10px;
        }

    .content-detail-wrapper {
        padding: 15px;
        background-color: #f5f5f5;
    }

    .article-container {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 0;
        margin-bottom: 20px;
    }

    .article-header {
        font-size: 1.25rem;
        font-weight: bold;
        padding: 15px;
        color: #333;
        line-height: 1.4;
    }

    .content-image-wrapper {
        margin: 15px;
        max-height: 400px;
        overflow: hidden;
        border-radius: 6px;
    }

    .content-detail-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .content-html {
        padding: 0 15px 15px 15px;
        font-size: 16px;
        line-height: 1.6;
        color: #444;
        overflow-x: auto;
    }
</style>

<div class="top-nav">
    <a href="javascript:history.back()" class="back-arrow">
        <i class="fa-solid fa-arrow-left"></i>
    </a>

    <span class="breadcrumb-item">
        <a   asp-area="" asp-controller="Dashboard" asp-action="AdminHome">Home</a>
    </span>

    <i class="fa-solid fa-angle-right"></i>

    <span class="breadcrumb-item">
        <a asp-controller="Horticulturehandbookweb" asp-action="CategoryIndex">ತೋಟಗಾರಿಕೆ ಕೈಪಿಡಿ ಮಾಹಿತಿ</a>

    </span>
        <i class="fa-solid fa-angle-right"></i>

    <span class="breadcrumb-item">@categoryName</span>

    <i class="fa-solid fa-angle-right"></i>
    @if (!string.IsNullOrEmpty(cropName))
    {
        <span class="breadcrumb-item">
            @cropName
            </span>
        <i class="fa-solid fa-angle-right"></i>
    }

    <span class="breadcrumb-item"> @sectionName
    </span>
    <i class="fa-solid fa-angle-right"></i>

    <span class="breadcrumb-active">@itemName</span>
</div>

<div id="contentDetailContainer" class="content-detail-wrapper">
    <p class="loading-message">Loading content...</p>
</div>

@Html.Hidden("fileBaseUrl", ViewBag.fileBaseUrl, new { id = "fileBaseUrl" })
@Html.Hidden("itemId", itemId, new { id = "itemId" })

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
                var rootPathList = ["/", "/UHSBWeb"];

        function GetRootPath(virtualPath) {
            if (window.currentTradeId == 7) {
                //LVB
                var pathIndex = $.inArray(virtualPath, rootPathList);
                if (pathIndex != -1) {
                    return (pathIndex == 0) ? rootPathList[pathIndex] : rootPathList[pathIndex] + "/";
                }
            }
            else {
                return $('#rootpath').text();
            }
        }
        let fileBaseUrl = $("#fileBaseUrl").val() || "";
        if (fileBaseUrl.includes("api")) fileBaseUrl = fileBaseUrl.replace("api", "");
        if (!fileBaseUrl.endsWith('/')) fileBaseUrl += '/';

        const itemId = $("#itemId").val();
        const container = $("#contentDetailContainer");

        function callGetApi(actionName, params = {}, onSuccess, onError) {
       
            $.ajax({
                url:  GetRootPath(window.virtualPath) +'/CommonApi/ForwardApiResponse?action_name=' + actionName,
                type: 'GET',
                dataType: 'json',
                data: params,
                success: onSuccess,
                error: onError
            });
        }

        function loadContentDetails() {
            if (!itemId) {
                container.html('<p class="error-message">Invalid content ID.</p>');
                return;
            }

            callGetApi(
                'CropProfile/Content/' + itemId,
                {},
                function (response) {
                    if (!response || response.length === 0) {
                        container.html('<p class="info-message">No content found.</p>');
                        return;
                    }

                    const row = response[0];
                    const imageUrl = row.imageUrl ? `${fileBaseUrl}InwardsInvoices/TempFiles/Content/${row.imageUrl}` : '';

                    let imageHtml = '';
                    if (row.imageUrl) {
                        imageHtml = `<div class="img-response">
                                        <img src="${imageUrl}" class="content-detail-image"
                                             alt="Content Image"
                                             onerror="this.onerror=null;this.src='https://via.placeholder.com/600x300?text=Image+Not+Available';" />
                                     </div>`;
                    }

                    const articleTitle = row.title || '@sectionName';

                    let html = `<div class="article-container">
                                  
                                    ${imageHtml}
                                    <div class="content-html">${row.description}</div>
                                </div>`;

                    container.html(html);
                },
                function () {
                    container.html('<p class="error-message">Failed to load content.</p>');
                }
            );
        }

        $(document).ready(loadContentDetails);
    </script>
}
