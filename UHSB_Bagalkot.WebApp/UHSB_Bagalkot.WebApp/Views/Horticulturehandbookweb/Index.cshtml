                        <label class="form-check-label fw-bold" for="enableFilter">Enable Filter</label>
                    </div>
                    <button class="btn btn-sm btn-light toggle-panel-btn" title="Collapse/Expand">
                        <i class="bi bi-chevron-up"></i>
                    </button>
                </div>
            </div>

            <div class="panel-body">
                <div class="filter-controls-group px-3 py-3 bg-light border-bottom">
                    <div class="row align-items-end">
                        <div class="col-md-3 mb-3">
                            <label for="CategoryDD" class="form-label fw-bold">Category</label>
                            <select class="cls-CategoryDD form-select form-select-sm">
                                <option value="">--Select Category--</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="CropsDD" class="form-label fw-bold">Crops</label>
                            <select class="cls-CropsDD form-select form-select-sm">
                                <option value="">--Select Crops--</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="SectionDD" class="form-label fw-bold">Section</label>
                            <select class="cls-SectionDD form-select form-select-sm">
                                <option value="">--Select Section--</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3 d-flex gap-2">
                            <button type="button" class="btn btn-primary" id="SearchItemBtn">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                            <button type="button" class="btn btn-secondary" id="SearchItemBtnAll">
                                <i class="bi bi-list me-1"></i> Show All
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-end px-3">
                    <button class="btn btn-sm btn-success add-btn-items" data-type="item">
                        <i class="bi bi-journal-plus me-1"></i> Add New Item
                    </button>
                </div>

                <div class="card-body p-0">
                    <div id="itemscontent">
                        <div class="table-container">
                            <table id="ItemTable" class="table table-striped table-hover align-middle">
                                <thead class="table-success text-dark">
                                    <tr>
                                        <th>SlNo</th>
                                        <th>Category</th>
                                        <th>Section</th>
                                        <th>Crops</th>
                                        <th>Item Name</th>
                                        <th>Image File</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <nav>
                                <ul id="itemsPaginationContainer" class="pagination justify-content-center mt-3"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div> <!-- /.panel-body -->
        </div>
    </div>
</div>

<!-- Crop Modal -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="itemForm" enctype="multipart/form-data">
                <div class="modal-header theme-header">
                    <h5 class="modal-title" id="itemModalLabel">Add/Edit Crop Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="CropId" />
                    <input type="hidden" id="itemType" />
                    <input type="hidden" id="filename" />


                    <div class="row g-3">


                        <div class="col-md-6" id="categorySelectionGroup">
                            <label for="Categoriestype" class="form-label fw-bold">Category</label>
                            <select id="Categoriestype" class="form-select form-select-sm">
                                <option value="">--Select Category--</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="itemName" class="form-label fw-bold">Name</label>
                            <input type="text" class="form-control form-control-sm" id="itemName" required />
                        </div>
                        <div class="col-md-6">
                            <label for="itemImage" class="form-label fw-bold">Images</label>
                            <input type="file" class="form-control form-control-sm" id="itemImage" accept="image/*" multiple />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Preview</label>
                            <div id="imagePreview" class="border rounded p-2 d-flex flex-wrap gap-2" style="min-height: 38px;"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveCropsBtn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

