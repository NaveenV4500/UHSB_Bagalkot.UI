                                <div id="categorycontent">
                                    <div class="table-container">
                                        <table id="categoriesTable" class="table table-striped table-hover align-middle">
                                            <thead class="text-dark">
                                                <tr>
                                                    <th>SlNo</th>
                                                    <th>Category Name</th>
                                                    <th>Image File</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section Details -->
                    <div class="col-lg-6 mb-4" id="section-section">
                        <div class="card">
                            <div class="card-header custom_card">
                                Section Details
                            </div>
                            <div class="card-body p-0">
                                <div id="Sectioncontent">
                                    <div class="table-container">
                                        <table id="SectionTable" class="table table-striped table-hover align-middle">
                                            <thead class="text-dark">
                                                <tr>
                                                    <th>SlNo</th>
                                                    <th>Section Name</th>
                                                    <th>Image File</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- panel-body -->
        </div>
    </div>
</div>



<!-- Crops Details (Moved to a correct row structure) -->
